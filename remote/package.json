{
  "name": "page2ai-mcp-remote",
  "private": true,
  "version": "0.1.0",
  "description": "Hosted (Streamable HTTP) variant of the Page2AI MCP server, deployed on Vercel. Same tool implementation as the local stdio server.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:local": "tsx scripts/local-serve.mts",
    "smoke": "node scripts/smoke-remote.mjs",
    "smoke:native": "node scripts/smoke-native.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@page2ai/mcp": "^0.2.5",
    "mcp-handler": "^2.1.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
