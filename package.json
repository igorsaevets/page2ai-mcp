{
  "name": "@page2ai/mcp",
  "version": "0.2.3",
  "mcpName": "io.github.igorsaevets/page2ai-mcp",
  "description": "MCP server that converts any web page URL to clean Markdown for LLM context. Zero external API calls, SSRF-guarded, 100% local.",
  "type": "module",
  "bin": {
    "page2ai-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "PRIVACY.md",
    "LICENSE",
    "manifest.json",
    "server.json"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"import('node:fs').then(({chmodSync})=>chmodSync('dist/index.js',0o755))\"",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "probe": "node scripts/probe-protocol.mjs node dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@page2ai/core": "^0.1.4",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "markdown",
    "html-to-markdown",
    "webpage-to-markdown",
    "web-scraping",
    "llm",
    "ai",
    "claude",
    "cursor",
    "windsurf",
    "zed",
    "rag",
    "page2ai"
  ],
  "author": {
    "name": "Igor Saevets",
    "email": "igorsaevets@gmail.com",
    "url": "https://github.com/igorsaevets"
  },
  "license": "MIT",
  "homepage": "https://igorsaevets.github.io/page2ai-docs/",
  "repository": {
    "type": "git",
    "url": "https://github.com/igorsaevets/page2ai-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/igorsaevets/page2ai-mcp/issues"
  }
}
